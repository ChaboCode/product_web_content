<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_web_content" model="ir.ui.view">
        <field name="name">product.template.form.web.content</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Contenido web" name="web_content">
			<group string="Compra en línea" name="web_purchase_group">
			    <field name="web_purchase" />
	    	    </group>
                    <group string="Descripción web" name="web_description_group">
                        <field name="web_description" nolabel="1" colspan="2"
                               placeholder="Texto descriptivo que mostrará el sitio..."/>
                    </group>
                    <group string="Imágenes adicionales" name="web_images_group">
                        <field name="web_image_ids" nolabel="1" colspan="2"
                               mode="kanban" context="{'default_product_tmpl_id': id}">
                            <kanban string="Imágenes adicionales">
                                <field name="id"/>
                                <field name="name"/>
                                <field name="sequence"/>
                                <field name="product_template_attribute_value_ids"/>
                                <templates>
                                    <t t-name="card">
                                        <field name="image_512" widget="image"
                                               options="{'preview_image': 'image_128'}"/>
                                        <field name="name" class="fw-bold"/>
                                        <field name="product_template_attribute_value_ids"
                                               widget="many2many_tags"/>
                                    </t>
                                </templates>
                            </kanban>
                            <form string="Imagen adicional">
                                <sheet>
                                    <field name="image_1920" widget="image" class="float-start"/>
                                    <group>
                                        <field name="name"/>
                                        <field name="sequence"/>
                                        <field name="product_template_attribute_value_ids"
                                               widget="many2many_tags"
                                               options="{'no_create': True}"/>
                                        <field name="product_tmpl_id" invisible="1"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
